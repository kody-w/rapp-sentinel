<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rapp.neighborhood-watch</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/kodywildfeuer/rapp-sentinel/run.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/kodywildfeuer</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/kodywildfeuer/.local/bin</string>
  </dict>

  <!-- Every 15 minutes. The rappterverse heartbeat is 30 min, so this is fast
       enough to catch a stall inside one cycle without doubling the work. -->
  <key>StartInterval</key>
  <integer>900</integer>

  <key>RunAtLoad</key>
  <true/>

  <!-- Deliberately NOT KeepAlive: this is a periodic task, not a daemon.
       KeepAlive would restart it in a tight loop the moment a tick exits. -->
  <key>StandardOutPath</key>
  <string>/Users/kodywildfeuer/rapp-sentinel/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/kodywildfeuer/rapp-sentinel/logs/launchd.err.log</string>
</dict>
</plist>
